    {
        "id": "cf4a78191a4ee1db",
        "type": "function",
        "z": "9c3baf713e23dc48",
        "name": "build AI prompt",
        "func": "var p = msg.payload;\nvar prompt = \"You are a building safety assistant. In ONE short sentence, explain what is happening and what to do. Data: state=\" + p.severity + \", gas_delta=\" + p.gas_delta + \", flame=\" + p.flame + \", temp=\" + p.temp + \"C, humidity=\" + p.hum + \"%.\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.payload = { contents: [ { parts: [ { text: prompt } ] } ] };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
